{
    "manifest_version": 3,
    "name": "ServiceNow Dependency Tracker",
    "version": "1.0.0",
    "description": "Shows Depends On / Used By for the Script Include, Business Rule, Client Script, UI Page, or other ServiceNow record you have open.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "Dependency Tracker",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["sidePanel", "tabs"],
    "host_permissions": ["https://*.service-now.com/*"],
    "content_scripts": [
        {
            "matches": ["https://*.service-now.com/*"],
            "js": ["context-detector.js", "content-script.js"],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ]
}
